{
  "rewrites": [
    {
      "source": "/api/test-gmail",
      "destination": "/api/test-gmail.js"
    },
    {
      "source": "/api/debug",
      "destination": "/api/debug.js"
    },
    {
      "source": "/api/otp/send",
      "destination": "/api/otp.js"
    },
    {
      "source": "/api/otp/verify",
      "destination": "/api/otp.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/admin.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
