{
  "rewrites": [
    {
      "source": "/api/test-gmail",
      "destination": "/api/test-gmail"
    },
    {
      "source": "/api/debug",
      "destination": "/api/debug"
    },
    {
      "source": "/api/otp/send",
      "destination": "/api/otp"
    },
    {
      "source": "/api/otp/verify",
      "destination": "/api/otp"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/admin.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
